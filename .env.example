# Core app
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Motion Control AI"
# theme UI 主题（default、dark、light 等），供 next-themes 或自定义主题系统读取
NEXT_PUBLIC_THEME = "default"
# appearance 外观模式（dark / light），配合 NEXT_PUBLIC_THEME 使用
NEXT_PUBLIC_APPEARANCE = "dark"
# 是否显示（品牌标识）在页面底部或特定位置显示 “Powered by ShipAny”文字。代码搜索未发现任何引用。
# NEXT_PUBLIC_SHOW_POWERED_BY="false" 
# 其它 不用填
NEXT_PUBLIC_APP_DESCRIPTION="" #制空
NEXT_PUBLIC_APP_LOGO="/logo.png"
NEXT_PUBLIC_APP_FAVICON="/favicon.ico"
NEXT_PUBLIC_APP_PREVIEW_IMAGE="/preview.png"
NEXT_PUBLIC_DEFAULT_LOCALE="en" #默认语言 若留空，默认 en .若站点主要面向中文用户，可改为 zh
NEXT_PUBLIC_LOCALE_DETECT_ENABLED="false" # 是否 自动检测浏览器语言 并切换 locale
NEXT_PUBLIC_DEBUG="false" #是否开启 调试模式 。代码搜索未发现任何引用。虽然在 src/config/index.ts 中有定义，但没有任何组件或服务读取这个值。

# Database
DB_SCHEMA="public"

DATABASE_PROVIDER="postgresql"
DATABASE_URL=""
DB_SINGLETON_ENABLED="true"
DB_MAX_CONNECTIONS="1"
DATABASE_AUTH_TOKEN="" #如果你使用 公开的数据库 URL（DATABASE_URL）且不需要额外的 token，保持空字符串即可

# Auth and RBAC
# 提示词:你帮我使用 openssl rand -base64 32 命令生成的一个新的随机密钥
AUTH_SECRET=""
# 这个变量在旧版本或其他模板中常用于简单管理员权限校验，但在当前项目中，权限系统（RBAC）已经完全迁移到了数据库驱动（基于 user_role 和 role_permission 表），代码中并没有读取该环境变量的地方。
# ADMIN_EMAILS="admin@example.com"


# Admin settings overrides
# Use the UPPERCASE setting key below to override the value stored in Admin -> Settings.
# Branding-related settings are sourced from the NEXT_PUBLIC_APP_* variables above.

# General
INITIAL_ROLE_ENABLED="false"  # 初始角色分配开关 。如果是 true，则进行自动角色分配。
INITIAL_ROLE_NAME="viewer"    # 当上面的开关开启时，系统会按照这个名字去数据库查找角色并分配给新用户  （只读/浏览者）
INITIAL_CREDITS_ENABLED="false" # 赠送积分开关
INITIAL_CREDITS_AMOUNT="0"
INITIAL_CREDITS_VALID_DAYS="30"
INITIAL_CREDITS_DESCRIPTION="initial credits for free trial"

# Auth providers
EMAIL_AUTH_ENABLED="true" #邮箱认证开关。如果开启，用户可以使用邮箱登录。
EMAIL_VERIFICATION_ENABLED="false"
GOOGLE_AUTH_ENABLED="false"
GOOGLE_ONE_TAP_ENABLED="false"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Github Auth https://authjs.dev/getting-started/providers/github
GITHUB_AUTH_ENABLED="false"
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Storage
R2_UPLOAD_PATH=""
R2_ACCESS_KEY=""
R2_SECRET_KEY=""
R2_BUCKET_NAME=""
R2_ENDPOINT=""
R2_DOMAIN=""

# Payments
SELECT_PAYMENT_ENABLED="false"  # 选择支付方式开关。如果开启，用户可以在支付时选择支付方式。
DEFAULT_PAYMENT_PROVIDER="stripe" # 默认支付方式。如果不允许用户选择支付方式，则使用默认支付方式

STRIPE_ENABLED="false"
STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_SIGNING_SECRET=""
STRIPE_PAYMENT_METHODS="[\"card\"]"
STRIPE_PROMOTION_CODES="{}"
STRIPE_ALLOW_PROMOTION_CODES="false"

CREEM_ENABLED="false"
CREEM_ENVIRONMENT="sandbox"
CREEM_API_KEY=""
