      "faq": {
        "id": "faq",
        "title": "Frequently Asked Questions about Pricing",
        "items": [
          {
            "question": "What is the difference between credit packs and subscriptions?",
            "answer": "Credit packs are one-time purchases valid for 365 days. Subscriptions renew on a monthly or annual cycle and grant fresh credits based on the selected plan."
          },
          {
            "question": "How much does a video generation cost?",
            "answer": "The credit cost is shown in the generator and varies by model, generation mode, resolution, and duration."
          },
          {
            "question": "Can I cancel my subscription at any time?",
            "answer": "Yes. You can cancel your subscription at any time. You will continue to have access to your credits until they expire."
          },
          {
            "question": "Is there a free trial?",
            "answer": "Free trial credits are not enabled by default. If trial credits are offered in the future, their availability and limits will be shown before generation."
          },
          {
            "question": "What payment methods are accepted?",
            "answer": "We accept all major credit and debit cards through our secure payment processor."
          },
          {
            "question": "Do unused credits roll over?",
            "answer": "Credit pack and annual plan credits are valid for 365 days. Monthly subscription credits are valid for 30 days."
          },
          {
            "question": "How are annual credits granted?",
            "answer": "Annual subscription credits are granted upfront after payment succeeds."
          },
          {
            "question": "Does 1 credit equal 1 generation?",
            "answer": "No, 1 credit does not equal 1 generation. Advanced models, higher resolutions and longer videos require more credits; the generator shows the estimate before submission."
          }
        ]
      },
